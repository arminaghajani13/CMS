{
  "name": "react-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tailwind": "tailwindcss -i ./src/index.css -o ./dist/output.css",
    "tailwind:watch": "tailwindcss -i ./src/index.css -o ./dist/output.css --watch",
    "start": "npm run tailwind:watch & npm run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@headlessui/react": "^2.2.0",
    "@mui/material": "^6.4.7",
    "@tailwindcss/vite": "^4.0.13",
    "react-icons": "^5.5.0",
    "react-router": "^7.3.0",
    "recharts": "^2.15.1",
    "sass": "^1.85.1",
    "tailwindcss": "^4.0.13"
  }
}
